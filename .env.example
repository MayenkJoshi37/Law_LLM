# Kaisan Legal uses bring-your-own-provider keys in live browser memory.
# Do not put OpenAI, Gemini, Groq, Anthropic, or OpenRouter keys in this file.
# Provider keys are sent only with the active browser session's requests.

# Optional: turn on LangSmith tracing when diagnosing the RAG workflow.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=kaisan-legal
